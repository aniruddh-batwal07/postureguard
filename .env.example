# ── Host / Ports ─────────────────────────────────────────────────────────────
# Bind address for all services (loopback only).
HOST=127.0.0.1

# Dashboard (Vite dev server)
WEB_PORT=5173

# Backend (Express)
BACKEND_PORT=4000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# URI used by the backend to connect. Must match the container exposed by
# docker-compose.yml (host port 27017).
MONGODB_URI=mongodb://127.0.0.1:27017/postureguard

# Host-side port the Mongo container is published on (informational / docs).
MONGODB_HOST_PORT=27017

# ── CV Service ───────────────────────────────────────────────────────────────
# Camera device index passed to cv2.VideoCapture.
CAMERA_INDEX=0

# ── Hardware Placeholder ─────────────────────────────────────────────────────
# Serial port the Arduino will be connected to. The backend does not use this
# yet; it is here so every process can share one source of truth.
ARDUINO_SERIAL_PORT=/dev/ttyACM0