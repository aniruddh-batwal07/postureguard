# ── Host / Ports ─────────────────────────────────────────────────────────────
# Bind address for all services (loopback only).
HOST=127.0.0.1

# Dashboard (Vite dev server)
WEB_PORT=5173

# Backend (Express)
BACKEND_PORT=4000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# URI used by the backend to connect. Must match the container exposed by
# docker-compose.yml (host port 27017).
MONGODB_URI=mongodb://127.0.0.1:27017/postureguard

# How long the backend waits for a MongoDB server to respond before it reports
# the connection as failed (used for startup + status checks).
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Host-side port the Mongo container is published on (informational / docs).
MONGODB_HOST_PORT=27017

# ── CV Service ───────────────────────────────────────────────────────────────
# Camera device index passed to cv2.VideoCapture.
CAMERA_INDEX=0

# M2.3 slouch detection rules. A live posture whose deviation magnitude from the
# session baseline exceeds CV_SLOUCH_THRESHOLD must stay that way for
# CV_SLOUCH_DURATION_SECONDS before a slouch_violation event fires; after a
# violation, returning within range must hold for CV_CORRECTION_DURATION_SECONDS
# before a correction_requested event fires. Transient deviations are ignored.
CV_SLOUCH_THRESHOLD=0.15
CV_SLOUCH_DURATION_SECONDS=2.0
CV_CORRECTION_DURATION_SECONDS=2.0

# ── Hardware Placeholder ─────────────────────────────────────────────────────
# Serial port the Arduino will be connected to. The backend does not use this
# yet; it is here so every process can share one source of truth.
ARDUINO_SERIAL_PORT=/dev/ttyACM0

# How long the backend waits for the device to acknowledge a BLOCK/RETRIEVE/
# STATUS command before it reports a hardware timeout (docs/architecture.md
# §4.3, ADR-4).
HARDWARE_COMMAND_TIMEOUT_MS=5000